# Einstellungen des Agent-Portals. Als ".env" neben compose.yaml ablegen.
# Pflicht sind nur die beiden Werte im ersten Block; alles mit # davor ist
# optional und bleibt so, solange du es nicht brauchst.
#
# Werte mit $ oder # gehoeren in einfache Anfuehrungszeichen: Docker liest
# diese Datei selbst ein, $ loest Variablen-Expansion aus und # beginnt einen
# Kommentar. Beispiel: TANSS_PASSWORD='ab$c#d'

# ===== Pflicht ==============================================================

# Adresse der TANSS-API, in der Regel die TANSS-Adresse mit /backend am Ende.
TANSS_BASE_URL=https://tanss.example.com/backend

# Schluessel fuer die Anmelde-Cookies, mindestens 32 zufaellige Zeichen.
# Erzeugen: macOS/Linux "openssl rand -hex 32", PowerShell siehe README.
SESSION_SECRET=bitte-ersetzen-durch-mindestens-32-zufaellige-zeichen

# ===== Anmeldung (optional) =================================================

# 2FA-Code automatisch erzeugen: reiner Base32-Schluessel oder die komplette
# otpauth://totp/...-URI. Dann fragt die Anmeldung nur noch Benutzername und
# Passwort ab. Achtung: der zweite Faktor liegt damit neben den Zugangsdaten.
# TOTP_SECRET=JBSWY3DPEHPK3PXP

# Rueckfall-Anmeldung ohne Menschen (nur zusammen mit TOTP_SECRET): meldet
# sich bei einer abgelaufenen TANSS-Sitzung selbst neu an. Standardmaessig
# aus, weil dann Passwort UND zweiter Faktor auf dieser Maschine liegen. Der
# Dashboard-Sammler braucht das nicht. Laenge im Container pruefen:
#   docker compose exec portal sh -c 'printf "%s" "$TANSS_PASSWORD" | wc -c'
# TANSS_USERNAME=vorname.nachname
# TANSS_PASSWORD='geheim'

# ===== Weitere Funktionen (optional) ========================================

# Linear-Tagesimport: persoenlicher API-Key (Linear -> Settings -> API ->
# Personal API keys). Ohne ihn meldet der Import-Tab nur, dass keine
# Verbindung eingerichtet ist.
# LINEAR_API_KEY='lin_api_...'

# Weboberflaeche von TANSS fuer den Link "In TANSS oeffnen"; ohne Eintrag
# aus TANSS_BASE_URL abgeleitet.
# TANSS_TICKET_URL=https://tanss.example.com/index.php?section=bug&sub=view&bugID=

# Jeden TANSS-Aufruf auf der Konsole ausgeben (Fehler immer).
# DEBUG_TANSS=1

# ===== Updates und Docker (optional) ========================================

# Port im Browser: http://127.0.0.1:<HOST_PORT> (Standard 3848). Das Portal
# ist nur von diesem Rechner aus erreichbar.
# HOST_PORT=3848

# Image-Tag fuer Portal und Updater: latest (Standard), staging oder eine feste
# Version wie 0.3.0. Eine feste Version schaltet Ein-Klick-Updates ab.
# PORTAL_TAG=latest

# Welche Versionen das Update-Banner anbietet: stable (Standard, nur
# freigegebene) oder staging (auch Vorabversionen).
# UPDATE_CHANNEL=stable

# Update-Abfrage bei GitHub abschalten: 0 = aus (kein Banner).
# UPDATE_CHECK=1

# Name des Compose-Projekts; bestimmt die Containernamen.
# COMPOSE_PROJECT_NAME=agent-portal

# Zweite Instanz zum Testen von Vorabversionen (eigener Ordner, siehe README):
# COMPOSE_PROJECT_NAME=agent-portal-staging
# HOST_PORT=3849
# PORTAL_TAG=staging
# UPDATE_CHANNEL=staging

# ===== Nur ohne Docker (npm run dev / npm start) ============================

# Unter Docker setzt compose.yaml diese Werte selbst.
# PORT=3848
# BIND=127.0.0.1
# DATA_DIR=data
