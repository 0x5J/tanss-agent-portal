TANSS_BASE_URL=https://tanss.example.com/backend
SESSION_SECRET=bitte-ersetzen-durch-mindestens-32-zufaellige-zeichen
PORT=3848
BIND=127.0.0.1

# 2FA-Code automatisch erzeugen: reiner Base32-Schluessel oder die komplette
# otpauth://totp/...-URI. Ist der Wert gesetzt, fragt die Anmeldung nur noch
# Benutzername und Passwort ab. Achtung: damit liegt der zweite Faktor neben
# den Zugangsdaten -> Datei nicht ins Repo, chmod 600.
# TOTP_SECRET=JBSWY3DPEHPK3PXP

# TANSS-Zugangsdaten des Portal-Nutzers (zusammen mit TOTP_SECRET). Wenn
# gesetzt: eine abgelaufene TANSS-Sitzung heilt sich selbst statt auszuloggen,
# und der Server zaehlt alle 5 Minuten die Ticketlisten fuer das Dashboard --
# auch ohne offenen Browser. Achtung: damit liegen Passwort UND zweiter Faktor
# auf dieser Maschine -> Datei nicht ins Repo, chmod 600.
# TANSS_USERNAME=vorname.nachname
# TANSS_PASSWORD='geheim'
#
# WICHTIG: Werte mit $ oder # gehoeren in einfache Anfuehrungszeichen.
# Docker liest diese Datei selbst ein: $ loest Variablen-Expansion aus und
# # gilt als Kommentarbeginn -- ohne Quotes kommt im Container ein anderes
# Passwort an als hier steht, und TANSS sperrt nach genug Fehlversuchen das
# Konto. Pruefen laesst sich das so:
#   docker exec agent-portal sh -c 'printf "%s" "$TANSS_PASSWORD" | wc -c' 

# Linear-Tagesimport: persoenlicher API-Key (Linear -> Settings -> API ->
# Personal API keys). Ohne ihn bleibt der Import-Tab sichtbar und meldet, dass
# keine Verbindung eingerichtet ist; alles andere funktioniert unabhaengig davon.
# LINEAR_API_KEY='lin_api_...'

# Weboberflaeche von TANSS fuer den Ticket-Link; ohne Eintrag abgeleitet.
# TANSS_TICKET_URL=https://tanss.example.com/index.php?section=bug&sub=view&bugID=

# Jeden TANSS-Aufruf auf der Konsole ausgeben (Fehler immer)
# DEBUG_TANSS=1

# Ablage fuer KI-Einstellungen und Freigabe-Queue (Standard: ./data)
# DATA_DIR=data
